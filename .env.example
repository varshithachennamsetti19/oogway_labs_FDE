# ===================================================================
# The Lenny Growth Assistant - Environment Configuration
# ===================================================================

# LLM Provider Configuration
# Options: anthropic | openai | ollama
DEFAULT_LLM_PROVIDER=anthropic

# Primary Cloud Provider API Keys (Required if using Cloud)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Local Model Configuration (Mandatory Demo Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database Configuration (PostgreSQL + pgvector)
# For local dev without docker: postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth_db
# For Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/lenny_growth_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth_db

# RAG & Embedding Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.3
TOP_K_CHUNKS=4

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
